<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Signal de présence à SAWALI (règle 4) : nom de l'application, version, modèle du téléphone ; aucune donnée personnelle -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Position GPS de la maison (profil de l'utilisateur) : demandée seulement quand on appuie sur « Ma position » ; jamais envoyée -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- Ma famille : suivi de position au premier plan (notification permanente), avertissements, et ajout d'un proche par contact NFC -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Test des balises Bluetooth (Estimote, iBeacon, Eddystone) : écoute des annonces pendant que l'écran de test est ouvert. SANS « neverForLocation » : Android filtrerait alors les balises. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Caméra partagée avec la famille : photo toutes les X secondes, service au premier plan avec notification permanente -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Récepteur de badges (lot 387) : écoute Bluetooth au premier plan et processeur éveillé -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Rappels de médicaments : alarmes à l'heure exacte (si le système l'autorise) et reprise après le redémarrage du téléphone -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Aide : proposer d'exclure l'application de l'économie de batterie (fenêtre du système, un appui) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <application android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:theme="@style/Theme.PersonnelMaison">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Étiquette NFC d'un médicament : poser le téléphone dessus confirme la prise -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.shuyah.med" />
            </intent-filter>
            <!-- Étiquette NFC des repas : « Je prends mon repas » puis « Repas terminé » -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.shuyah.repas" />
            </intent-filter>
        </activity>
        <!-- Suivi de position partagée avec la famille : service au premier plan de type « location » -->
        <service android:name=".ServicePosition" android:exported="false" android:foregroundServiceType="location" />
        <service android:name=".ServiceCamera" android:exported="false" android:foregroundServiceType="camera" />
        <service android:name=".ServiceRecepteur" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <!-- Ajout d'un proche par NFC : émulation de carte qui répond avec le code d'invitation -->
        <service android:name=".ServiceNfcFamille" android:exported="true" android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter><action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" /></intent-filter>
            <meta-data android:name="android.nfc.cardemulation.host_apdu_service" android:resource="@xml/apdu_service" />
        </service>
        <!-- Rappels de médicaments (alarmes, boutons de la notification, redémarrage) et veille des proches -->
        <receiver android:name=".RecepteurMedicament" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".RecepteurSurveillance" android:exported="false" />
        <receiver android:name=".RecepteurRepas" android:exported="false" />
        <!-- Partage de la photo prise pour la pièce d'identité (dossier temporaire privé) -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.photos" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chemins_photos" />
        </provider>
    </application>
</manifest>
